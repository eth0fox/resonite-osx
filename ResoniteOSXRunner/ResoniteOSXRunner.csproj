<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    
    <PropertyGroup>
        <ResonitePath>../resonite</ResonitePath>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="FrooxEngine">
            <HintPath>$(ResonitePath)\FrooxEngine.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Renderite.Shared">
            <HintPath>$(ResonitePath)\Renderite.Shared.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Elements.Assets">
            <HintPath>$(ResonitePath)\Elements.Assets.dll</HintPath>
            <Private>false</Private>
        </Reference>



    </ItemGroup>


    <ItemGroup>
      <PackageReference Include="Lib.Harmony" Version="2.4.2" />
      <PackageReference Include="Microsoft.Extensions.ObjectPool" Version="11.0.0-preview.4.26230.115" />
      <PackageReference Include="ppy.Veldrid.MetalBindings" Version="4.9.76-g3cdad6c06a" />
    </ItemGroup>

</Project>
